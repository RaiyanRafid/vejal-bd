# vejal-bd environment. Copy to .env and fill in. Never commit .env.
# Generate each secret with:  openssl rand -base64 32
# Every secret must be at least 32 characters (src/lib/env.ts enforces this).

# ── Database ────────────────────────────────────────────────────────────
# Percent-encode special characters in the password (@ → %40, ! → %21, # → %23).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Integration tests TRUNCATE every table. Point this at a separate schema
# (search_path=test) or database, never at data you care about.
TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?options=-csearch_path%3Dtest

# ── Hashing & encryption secrets (versioned for rotation) ──────────────
PASSWORD_PEPPER_V1=
HMAC_USERNAME_KEY_V1=
HMAC_EMAIL_KEY_V1=
HMAC_TRACKING_KEY_V1=
# AES-256-GCM key for admin TOTP secrets: exactly 32 random bytes, base64.
TOTP_ENC_KEY=
ALTCHA_HMAC_KEY=

# ── Object storage (MinIO, S3-compatible) ───────────────────────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=vejal-images
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Cloudflare (leave empty in dev: CDN purge becomes a no-op) ──────────
CLOUDFLARE_ZONE_ID=
# API token scoped to "Zone → Cache Purge" only.
CLOUDFLARE_PURGE_TOKEN=
# true in prod: /admin requires Cloudflare Access in front.
CF_ACCESS_REQUIRED=false

# ── Production only (docker-compose.prod.yml) ───────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=
# BACKUP_AGE_PUBKEY=
